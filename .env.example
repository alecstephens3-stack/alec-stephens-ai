# Resend API key. Without it the contact form returns 503 and tells the
# visitor to email directly.
RESEND_API_KEY=

# Sender address. Leave unset until stephensai.co (or send.stephensai.co) is
# Verified in Resend; the code falls back to Resend's sandbox sender, which
# works but only delivers to the Resend account owner's own address.
# Once verified:  CONTACT_FROM_EMAIL="Stephens AI <hello@stephensai.co>"
CONTACT_FROM_EMAIL=
